{
  "name": "review-backlog-restart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:repeat": "npm run build && playwright test --repeat-each=10 --workers=1",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
